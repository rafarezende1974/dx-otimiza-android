<resources>
<style name="Jpg.Panel" parent=""><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:layout_marginTop">16dp</item><item name="android:padding">20dp</item><item name="android:background">@drawable/card_dark</item></style>
<style name="Jpg.Body" parent=""><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:layout_marginTop">8dp</item><item name="android:textColor">@color/jpg_text</item><item name="android:textSize">15sp</item></style>
<style name="Jpg.Muted" parent="Jpg.Body"><item name="android:textColor">@color/jpg_muted</item><item name="android:textSize">13sp</item></style>
<style name="Jpg.Eyebrow" parent="Jpg.Muted"><item name="android:textSize">11sp</item><item name="android:letterSpacing">0.08</item></style>
<style name="Jpg.Title" parent="Jpg.Body"><item name="android:textSize">21sp</item><item name="android:textStyle">bold</item></style>
<style name="Jpg.Hero" parent="Jpg.Title"><item name="android:textSize">40sp</item><item name="android:textColor">@color/jpg_red</item></style>
<style name="Jpg.Button" parent="Widget.Material3.Button.OutlinedButton"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:minHeight">52dp</item><item name="android:layout_marginTop">8dp</item><item name="android:textColor">@color/jpg_text</item><item name="android:textAllCaps">false</item><item name="cornerRadius">14dp</item><item name="strokeColor">@color/jpg_border</item></style>
<style name="Jpg.Primary" parent="Jpg.Button"><item name="backgroundTint">@color/jpg_red</item><item name="android:textColor">#FFFFFF</item><item name="android:textStyle">bold</item></style>
<style name="Jpg.Option" parent=""><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:minHeight">48dp</item><item name="android:textColor">@color/jpg_text</item><item name="buttonTint">@color/jpg_red</item></style>
</resources>