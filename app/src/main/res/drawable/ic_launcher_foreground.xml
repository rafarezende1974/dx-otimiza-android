<?xml version="1.0" encoding="utf-8"?>
<!-- Ícone do JPG Otimiza (v0.2): lata de refrigerante diet genérica,
     sem marca, sem logo da DX Labs. A piada é a função: arquivo mais
     leve = versão diet. Só formas, sem texto: VectorDrawable não
     renderiza texto, então a lata se reconhece pela silhueta, pela
     aba de abrir e pela faixa ciano. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Corpo da lata -->
    <path
        android:fillColor="#F8FAFC"
        android:pathData="M38,34 L70,34 L70,80 L38,80 Z" />
    <!-- Ombro afunilado até a tampa -->
    <path
        android:fillColor="#E2E8F0"
        android:pathData="M38,34 L42,26 L66,26 L70,34 Z" />
    <!-- Tampa -->
    <path
        android:fillColor="#94A3B8"
        android:pathData="M54,26 m-12,0 a12,4 0,1 1,24 0 a12,4 0,1 1,-24 0" />
    <!-- Aba de abrir -->
    <path
        android:fillColor="#475569"
        android:pathData="M50,24 L58,24 L58,28 L50,28 Z" />
    <path
        android:fillColor="#111827"
        android:pathData="M54,26 m-2,0 a2,2 0,1 1,4 0 a2,2 0,1 1,-4 0" />
    <!-- Faixa ciano: o "diet" do app -->
    <path
        android:fillColor="#06B6D4"
        android:pathData="M38,52 L70,52 L70,64 L38,64 Z" />
    <!-- Brilho vertical da lata -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.35"
        android:pathData="M43,36 L47,36 L47,78 L43,78 Z" />
    <!-- Base -->
    <path
        android:fillColor="#CBD5E1"
        android:pathData="M38,78 L70,78 L70,82 L38,82 Z" />
</vector>
