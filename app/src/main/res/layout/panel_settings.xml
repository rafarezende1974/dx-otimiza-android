<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Jpg.Panel"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            style="@style/Jpg.Eyebrow"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="COMPRESSÃO" />

        <TextView
            android:id="@+id/txtOptionsSummary"
            style="@style/Jpg.Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:text="Equilíbrio (85)" />
    </LinearLayout>

    <!-- Presets 92/85/75 em três cartões altos quase quadrados -->
    <RadioGroup
        android:id="@+id/presetGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <RadioButton
            android:id="@+id/preset92"
            style="@style/Jpg.PresetCard"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:text="@string/preset_92" />

        <RadioButton
            android:id="@+id/preset85"
            style="@style/Jpg.PresetCard"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:text="@string/preset_85" />

        <RadioButton
            android:id="@+id/preset75"
            style="@style/Jpg.PresetCard"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:text="@string/preset_75" />
    </RadioGroup>

</LinearLayout>
