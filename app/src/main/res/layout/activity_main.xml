<?xml version="1.0" encoding="utf-8"?>
<!-- Visual v0.4: tela leve. Qualidade, EXIF e GPS saíram daqui
     e foram para o menu "Opções" (dialog_options.xml); na tela
     principal fica só um resumo de uma linha (txtOptionsSummary).
     Motor: só Android, MozJPEG removido. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111827"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="JPG Diet"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Motor MozJPEG • a origem nunca é alterada"
            android:textColor="#CBD5E1"
            android:textSize="14sp" />

        <!-- Contador de economia, como o "total saved" do JPEGmini -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_dark"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOTAL ECONOMIZADO"
                android:textColor="#9CA3AF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSavedTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0 MB"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSavedDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Nenhum lote ainda"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Prévia: primeira foto da pasta de origem -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_dark"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:id="@+id/imgPreview"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="#000000"
                android:contentDescription="Prévia da primeira foto da pasta de origem"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/txtPreviewHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_horizontal"
                android:text="Escolha a pasta de origem para ver a primeira foto aqui"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#374151"
            android:text="⋮ Opções (qualidade, EXIF, GPS)"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/txtOptionsSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_horizontal"
            android:text="Equilíbrio (85) • EXIF mantido"
            android:textColor="#CBD5E1"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txtSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Origem: nenhuma pasta escolhida"
            android:textColor="#F8FAFC" />

        <Button
            android:id="@+id/btnSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#374151"
            android:text="1) Escolher pasta de origem (JPGs)"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/txtDest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Destino: nenhuma pasta escolhida"
            android:textColor="#F8FAFC" />

        <Button
            android:id="@+id/btnDest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#374151"
            android:text="2) Escolher pasta de destino"
            android:textColor="#FFFFFF" />



        <Button
            android:id="@+id/btnAnalyze"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#374151"
            android:text="Analisar pasta"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnOptimize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#DC2626"
            android:text="OTIMIZAR LOTE"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progressTint="#DC2626" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Pronto."
            android:textColor="#F8FAFC" />

        <TextView
            android:id="@+id/txtCurrent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text=""
            android:textColor="#CBD5E1" />

        <TextView
            android:id="@+id/txtSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text=""
            android:textColor="#F8FAFC" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Teste primeiro com uma pasta-cópia pequena, não direto na pasta original do evento. Confira o resultado em 100% antes de entregar. Mantenha o app aberto durante o lote."
            android:textColor="#CBD5E1" />

    </LinearLayout>
</ScrollView>
