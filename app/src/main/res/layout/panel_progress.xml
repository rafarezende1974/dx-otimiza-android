<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Jpg.Panel"
    android:layout_marginTop="8dp"
    android:padding="12dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            style="@style/Jpg.Eyebrow"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="PROGRESSO" />

        <TextView
            android:id="@+id/txtCurrent"
            style="@style/Jpg.Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="middle"
            android:text=""
            android:accessibilityLiveRegion="polite" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progressTint="@color/jpg_red"
        android:progressBackgroundTint="@color/jpg_border" />

    <TextView
        android:id="@+id/txtStatus"
        style="@style/Jpg.Body"
        android:layout_marginTop="6dp"
        android:textSize="13sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="Escolha a origem para começar." />

    <TextView
        android:id="@+id/txtSummary"
        style="@style/Jpg.Muted"
        android:layout_marginTop="4dp"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="" />

</LinearLayout>
