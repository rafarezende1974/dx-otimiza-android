<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none"
    android:clipToPadding="false"
    android:background="@color/jpg_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding"
        android:paddingEnd="@dimen/page_padding"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <!-- Header: Logo no canto esquerdo, Menu Opções no canto direito -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="140dp"
                android:layout_height="44dp"
                android:adjustViewBounds="true"
                android:scaleType="fitStart"
                android:contentDescription="JPG Diet"
                android:src="@drawable/logo_jpg_diet" />

            <TextView
                style="@style/Jpg.Muted"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="Menos espaço. Mais possibilidades. Otimize seus JPEGs com controle." />

            <!-- Menu na parte superior direita -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOptions"
                style="@style/Jpg.CompactButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Opções ▾"
                android:contentDescription="Menu de opções" />
        </LinearLayout>

        <!-- Grade 2 colunas niveladas: Controles à esquerda, Prévia à direita -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- Coluna Esquerda: Métricas, Pastas, Presets, Ações, Progresso -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="12dp">

                <!-- 1. Métricas compactas no alto à esquerda -->
                <include layout="@layout/panel_metrics" />

                <!-- 2. Seleção de origem/destino com modo entre elas -->
                <include layout="@layout/panel_folders" />

                <!-- 3. Presets 92/85/75 em três cartões altos -->
                <include layout="@layout/panel_settings" />

                <!-- 4. Botão vermelho "Iniciar otimização" e "Analisar pasta" -->
                <include layout="@layout/panel_actions" />

                <!-- 5. Progresso com indicador percentual -->
                <include layout="@layout/panel_progress" />
            </LinearLayout>

            <!-- Coluna Direita: Prévia grande à direita no tablet -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1.05"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <include layout="@layout/panel_preview" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
